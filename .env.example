# 국토부 실거래가 API
MOLIT_API_KEY=your_molit_api_key_here

# 한국은행 ECOS 거시지표 API
ECOS_API_KEY=your_ecos_api_key_here

# 통계청 KOSIS API
KOSIS_API_KEY=your_kosis_api_key_here

# 카카오 REST API (POI 수집)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 공공데이터포털 (청약/기상청/공시지가/학교정보)
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# 교육통계 NEIS API (학업성취도)
NEIS_API_KEY=your_neis_api_key_here

# Slack 웹훅 (Airflow 알림, 선택사항)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# 데이터베이스 경로 (Airflow DAG에서 사용)
REALESTATE_DB=/path/to/realestate.db
REALESTATE_HOME=/path/to/realestate

# PostgreSQL (마이그레이션 시 필요)
DATABASE_URL=postgresql://user:password@localhost:5432/realestate

# Redis 캐시
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false   # true로 변경 시 캐시 활성화

# FastAPI 보안
JWT_SECRET_KEY=your_random_secret_key_here   # python -c "import secrets; print(secrets.token_hex(32))"
JWT_EXPIRE_MIN=60
API_KEY=your_api_key_here                    # 빈칸이면 인증 스킵 (개발용)
ADMIN_PASSWORD=your_admin_password_here      # /token 엔드포인트 비밀번호

# CORS (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:8000,https://your-domain.com
